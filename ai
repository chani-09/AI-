            document.getElementById('state-result').classList.add('hidden');
            document.getElementById('analysis-details').innerText = '判定を実行すると、文章の具体的な特徴やAI生成/人間筆記の根拠が表示されます。';
        }

        // --- Core AI Analysis Logic ---
        async function analyzeAI() {
            const text = document.getElementById('input-text').value.trim();
            if (!text) {
                showToast('判定するテキストを入力してください', 'fa-triangle-exclamation', 'text-amber-400');
                return;
            }

            // UI Switch to Loading
            document.getElementById('state-empty').classList.add('hidden');
            document.getElementById('state-result').classList.add('hidden');
            document.getElementById('state-loading').classList.remove('hidden');

            const steps = [
                "語彙の多様性と不規則性を解析中...",
                "構文パターンと定型表現の度合いを測定中...",
                "Gemini AIモデルによる言語表現のディープスキャン中..."
            ];
            
            let stepIdx = 0;
            const stepInterval = setInterval(() => {
                stepIdx = (stepIdx + 1) % steps.length;
                document.getElementById('loading-step').innerText = steps[stepIdx];
            }, 600);

            let resultData = null;

            try {
                // Try Gemini API Analysis first
                resultData = await fetchGeminiAIAnalysis(text);
            } catch (err) {
                console.warn('Gemini API call skipped or failed, using heuristic fallback logic:', err);
                // Fallback heuristic scoring
                resultData = calculateHeuristicAIScore(text);
            } finally {
                clearInterval(stepInterval);
            }

            // Render Results
            renderResults(resultData);
        }

        // Call Gemini API for structured JSON evaluation
        async function fetchGeminiAIAnalysis(inputText) {
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const systemPrompt = `あなたは高度なテキスト構造解析AIです。与えられた日本語テキストが「AI生成によるものか」「人間が執筆したものか」を分析し、JSON形式で結果を出力してください。
            回答には以下の形式の完全なJSONオブジェクトのみを含めてください（マークダウン装飾等は不要です）：
            {
              "score": <0から100の数値 (AI生成度)>,
              "verdictTitle": "<判定結果見出し (例: AI生成テキストの可能性が極めて高い / 人間が執筆した可能性が高い / ハイブリッド文書)>",
              "verdictDesc": "<簡潔な概要説明>",
              "vocabUniformity": <0〜100の数値>,
              "patternRate": <0〜100の数値>,
              "humanBurstiness": <0〜100の数値>,
              "analysisDetail": "<文章の特徴、語彙のパターン、文末表現などの具体的な分析フィードバック文章>"
            }`;

            const payload = {
                contents: [{ parts: [{ text: `以下のテキストのAI生成度を判定してください:\n\n${inputText}` }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] },
                generationConfig: {
                    responseMimeType: "application/json"
                }
            };

            const res = await fetchWithTimeout(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }, 8000);

            if (!res.ok) throw new Error(`HTTP ${res.status}`);

            const data = await res.json();
            const rawJson = data.candidates?.[0]?.content?.parts?.[0]?.text;
            return JSON.parse(rawJson);
        }

        // Fetch with timeout helper
        function fetchWithTimeout(url, options, timeout = 7000) {
            return Promise.race([
                fetch(url, options),
                new Promise((_, reject) => setTimeout(() => reject(new Error('Timeout')), timeout))
            ]);
        }

        // Heuristic fallback algorithm if API is unavailable
        function calculateHeuristicAIScore(text) {
            let aiScore = 50;

            // Indicator 1: Formal transitional phrases common in AI (まず第一に, しかしながら, 結論として, などの使用)
            const aiKeywords = ['まず第一に', 'さらに', 'しかしながら', '結論として', '観点において', '再定義', '重要性', '求められています', '可能性', '考えられます'];
            let keywordMatches = 0;
            aiKeywords.forEach(kw => { if (text.includes(kw)) keywordMatches++; });

            // Indicator 2: Punctuation & Emoji usage (Humans tend to use emojis, exclamation marks, or casual tone)
            const humanIndicators = ['！', '!', '〜', '～', '笑', 'かな', '（笑）', 'ねー', 'ね！', 'ちゃん', '昨日', 'カフェ', '気分'];
            let humanMatches = 0;
            humanIndicators.forEach(hw => { if (text.includes(hw)) humanMatches++; });

            // Score adjustments
            aiScore += (keywordMatches * 12);
            aiScore -= (humanMatches * 15);

            // Sentence length uniformity check
            const sentences = text.split(/[。！？\n]/).filter(s => s.trim().length > 0);
            if (sentences.length > 2) {
                const lengths = sentences.map(s => s.length);
                const avgLen = lengths.reduce((a, b) => a + b, 0) / lengths.length;
                const variance = lengths.reduce((a, b) => a + Math.pow(b - avgLen, 2), 0) / lengths.length;
                
                // Low variance in sentence length = more structured (AI-like)
                if (variance < 100) aiScore += 15;
                if (variance
